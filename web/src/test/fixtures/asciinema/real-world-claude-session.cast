[1361.216,"o","\u001b[32m/**\u001b[39m\r\n     \u001b[32m * Session as returned by API endpoints\u001b[39m\r\n     \u001b[32m * Includes everything from SessionInfo plus additional runtime/computed fields\u001b[39m\r\n     \u001b[32m */\u001b[39m\r\n     \u001b[34mexport\u001b[39m \u001b[34minterface\u001b[39m Session \u001b[34mextends\u001b[39m SessionInfo {\r\n       \u001b[36mlastModified\u001b[39m: \u001b[36mstring\u001b[39m;\r\n       active?: \u001b[36mboolean\u001b[39m;\r\n\r\n       \u001b[32m// Activity information (for dynamic title mode)\u001b[39m\r\n       activityStatus?: {\r\n         \u001b[36misActive\u001b[39m: \u001b[36mboolean\u001b[39m;\r\n         specificStatus?: {\r\n           \u001b[36mapp\u001b[39m: \u001b[36mstring\u001b[39m;\r\n           status: \u001b[36mstring\u001b[39m;\r\n         };\r\n       };\r\n\r\n       \u001b[32m// Source information (for HQ mode)\u001b[39m\r\n       source?: \u001b[31m'local'\u001b[39m | \u001b[31m'remote'\u001b[39m;\r\n       remoteId?: \u001b[36mstring\u001b[39m;\r\n       remoteName?: \u001b[36mstring\u001b[39m;\r\n       remoteUrl?: \u001b[36mstring\u001b[39m;\r\n     }\r\n\r\n     \u001b[32m/**\u001b[39m\r\n     \u001b[32m * Activity status for a session\u001b[39m\r\n     \u001b[32m */\u001b[39m\r\n     \u001b[34mexport\u001b[39m \u001b[34minterface\u001b[39m SessionActivity {\r\n  "]
